{
  "name": "cyber-horse-electron",
  "version": "0.1.0",
  "private": true,
  "description": "Cyber Horse 媒体工作流桌面应用",
  "main": "./out/main/index.js",
  "author": "Cyber Horse",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:desktop": "npm run build && node scripts/desktop-smoke.mjs && node scripts/desktop-task-queue.mjs && node scripts/desktop-dev-playback.mjs && node scripts/desktop-shutdown.mjs && node scripts/desktop-theme-startup.mjs",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win nsis",
    "dist:portable": "npm run build && electron-builder --win portable --x64 --config.electronDist=node_modules/electron/dist",
    "dist:unpacked": "npm run build && electron-builder --win --x64 --dir",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sax": "1.6.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sax": "1.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
